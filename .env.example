# Address used by the embedded HTTP server.
LISTEN_ADDRESS=0.0.0.0
PORT=42345

# Public URL of the external HTTPS reverse proxy, without a trailing slash.
BASE_URL=https://example.org

# Shared Let's Encrypt account email passed to every VPS setup.
CERTBOT_EMAIL=admin@example.org

# Optional state directory (defaults to the executable directory).
# Docker uses /data. Environment variables override values in this file.
# DATA_DIR=/var/lib/vps-orchestrator
